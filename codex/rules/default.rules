prefix_rule(pattern=["node", "-e", "const { chromium } = require('playwright'); (async()=>{ const browser=await chromium.launch({headless:true}); const context=await browser.newContext({viewport:{width:1366,height:768}, ignoreHTTPSErrors:true}); const page=await context.newPage(); await page.goto('http://localhost:4200/admin/dashboard', {waitUntil:'domcontentloaded', timeout:30000}); await page.waitForTimeout(2500); const inputs=await page.locator('input').evaluateAll(nodes=>nodes.map(n=>({type:n.getAttribute('type'), name:n.getAttribute('name'), id:n.id, placeholder:n.getAttribute('placeholder'), autocomplete:n.getAttribute('autocomplete')}))); const buttons=await page.locator('button, input[type=submit], a').evaluateAll(nodes=>nodes.slice(0,20).map(n=>({tag:n.tagName, type:n.getAttribute('type'), text:(n.innerText||n.getAttribute('value')||'').trim(), id:n.id, name:n.getAttribute('name')}))); console.log(JSON.stringify({url:page.url(), inputs, buttons}, null, 2)); await browser.close(); })().catch(err=>{ console.error(err); process.exit(1); });"], decision="allow")
prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "$env:PW_AUDIT_USER='lamld'; $env:PW_AUDIT_PASS='Zzxx25102001'; node -e \"const { chromium } = require('playwright'); (async()=>{ const browser=await chromium.launch({headless:true}); const context=await browser.newContext({viewport:{width:1366,height:768}, ignoreHTTPSErrors:true}); const page=await context.newPage(); const events=[]; page.on('console', msg=>{ if(['error','warning'].includes(msg.type())) events.push(msg.type()+': '+msg.text()); }); page.on('pageerror', err=>events.push('pageerror: '+err.message)); await page.goto('http://localhost:4200/admin/dashboard', {waitUntil:'domcontentloaded', timeout:30000}); if(page.url().includes('/protocol/openid-connect/auth')){ await page.fill('#username', process.env.PW_AUDIT_USER); await page.fill('#password', process.env.PW_AUDIT_PASS); await Promise.all([page.waitForNavigation({waitUntil:'domcontentloaded', timeout:30000}).catch(()=>{}), page.click('#kc-login')]); } await page.waitForTimeout(5000); const body=await page.locator('body').innerText({timeout:5000}).catch(e=>''); const buttons=await page.locator('button, [role=button], a[href], input[type=button], input[type=submit]').evaluateAll(nodes=>nodes.slice(0,80).map((n,i)=>({i, tag:n.tagName, text:(n.innerText||n.getAttribute('aria-label')||n.getAttribute('title')||n.getAttribute('value')||'').trim(), disabled:n.disabled||n.getAttribute('aria-disabled')==='true', href:n.getAttribute('href'), cls:n.className}))).catch(e=>[]); console.log(JSON.stringify({url:page.url(), title:await page.title().catch(()=>''), body:body.slice(0,1800), buttons, events:events.slice(0,20)}, null, 2)); await browser.close(); })().catch(err=>{ console.error(err); process.exit(1); });\""], decision="allow")
prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "$env:PW_AUDIT_USER='lamld'; $env:PW_AUDIT_PASS='Zzxx25102001'; node -e \"const { chromium } = require('playwright'); (async()=>{ const browser=await chromium.launch({headless:true}); const context=await browser.newContext({viewport:{width:1366,height:768}, ignoreHTTPSErrors:true}); const page=await context.newPage(); await page.goto('http://localhost:4200/admin/dashboard', {waitUntil:'domcontentloaded', timeout:30000}); if(page.url().includes('/protocol/openid-connect/auth')){ await page.fill('#username', process.env.PW_AUDIT_USER); await page.fill('#password', process.env.PW_AUDIT_PASS); await Promise.all([page.waitForNavigation({waitUntil:'domcontentloaded', timeout:30000}).catch(()=>{}), page.click('#kc-login')]); } await page.waitForTimeout(5000); await page.screenshot({path:'.tmp/audit-dashboard-desktop.png', fullPage:true}); await page.setViewportSize({width:390,height:844}); await page.waitForTimeout(1000); await page.screenshot({path:'.tmp/audit-dashboard-mobile.png', fullPage:true}); console.log(JSON.stringify({desktop:'.tmp/audit-dashboard-desktop.png', mobile:'.tmp/audit-dashboard-mobile.png', url:page.url()}, null, 2)); await browser.close(); })().catch(err=>{ console.error(err); process.exit(1); });\""], decision="allow")
prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "$env:PW_AUDIT_USER='lamld'; $env:PW_AUDIT_PASS='Zzxx25102001'; node -e \"const { chromium } = require('playwright'); (async()=>{ const browser=await chromium.launch({headless:true}); const context=await browser.newContext({viewport:{width:1366,height:768}, ignoreHTTPSErrors:true}); const page=await context.newPage(); await page.goto('http://localhost:4200/admin/dashboard', {waitUntil:'domcontentloaded', timeout:30000}); if(page.url().includes('/protocol/openid-connect/auth')){ await page.fill('#username', process.env.PW_AUDIT_USER); await page.fill('#password', process.env.PW_AUDIT_PASS); await Promise.all([page.waitForNavigation({waitUntil:'domcontentloaded', timeout:30000}).catch(()=>{}), page.click('#kc-login')]); } await page.waitForTimeout(5000); const results=[]; async function clickAndRead(name, locator){ try{ await locator.click({timeout:5000}); await page.waitForTimeout(1000); const text=await page.locator('body').innerText({timeout:3000}); results.push({name, url:page.url(), body:text.slice(0,1200)}); }catch(e){ results.push({name, error:e.message}); }} await clickAndRead('user-menu', page.locator('.user-menu-button')); await page.keyboard.press('Escape').catch(()=>{}); await clickAndRead('file-storage-tab', page.getByRole('button', {name:/File Storage/i})); await clickAndRead('ai-agent-tab', page.getByRole('button', {name:/AI Agent/i})); await clickAndRead('retry', page.getByRole('button', {name:/Thử lại/i}).first()); await clickAndRead('refresh', page.getByRole('button', {name:/Tải lại/i}).first()); console.log(JSON.stringify(results, null, 2)); await browser.close(); })().catch(err=>{ console.error(err); process.exit(1); });\""], decision="allow")
