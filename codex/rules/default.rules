prefix_rule(pattern=["node", "-e", "const { chromium } = require('playwright'); (async()=>{ const browser=await chromium.launch({headless:true}); const context=await browser.newContext({viewport:{width:1366,height:768}, ignoreHTTPSErrors:true}); const page=await context.newPage(); const failures=[]; page.on('requestfailed', req=>failures.push({url:req.url(), failure:req.failure()?.errorText})); await page.goto('http://127.0.0.1:4300/admin/dashboard', {waitUntil:'domcontentloaded', timeout:30000}).catch(e=>failures.push({goto:e.message})); await page.waitForTimeout(3000); const body=await page.locator('body').innerText({timeout:5000}).catch(e=>''); console.log(JSON.stringify({url:page.url(), title:await page.title().catch(()=>''), body:body.slice(0,1200), failures:failures.slice(0,10)}, null, 2)); await browser.close(); })().catch(err=>{ console.error(err); process.exit(1); });"], decision="allow")
prefix_rule(pattern=["node", "-e", "const { chromium } = require('playwright'); (async()=>{ const browser=await chromium.launch({headless:true}); const context=await browser.newContext({viewport:{width:1366,height:768}, ignoreHTTPSErrors:true}); const page=await context.newPage(); const failures=[]; page.on('requestfailed', req=>failures.push({url:req.url(), failure:req.failure()?.errorText})); await page.goto('http://127.0.0.1:4200/admin/dashboard', {waitUntil:'domcontentloaded', timeout:30000}).catch(e=>failures.push({goto:e.message})); await page.waitForTimeout(3000); const body=await page.locator('body').innerText({timeout:5000}).catch(e=>''); console.log(JSON.stringify({url:page.url(), title:await page.title().catch(()=>''), body:body.slice(0,1200), failures:failures.slice(0,10)}, null, 2)); await browser.close(); })().catch(err=>{ console.error(err); process.exit(1); });"], decision="allow")
