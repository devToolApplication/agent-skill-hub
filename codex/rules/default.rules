prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "$env:PW_AUDIT_USER='lamld'; $env:PW_AUDIT_PASS='Zzxx25102001'; node -e \"const { chromium } = require('playwright'); (async()=>{ const browser=await chromium.launch({headless:true}); const context=await browser.newContext({viewport:{width:1366,height:768}, ignoreHTTPSErrors:true}); const page=await context.newPage(); const events=[]; page.on('console', msg=>{ if(['error','warning'].includes(msg.type())) events.push(msg.type()+': '+msg.text()); }); page.on('pageerror', err=>events.push('pageerror: '+err.message)); await page.goto('http://localhost:4200/admin/dashboard', {waitUntil:'domcontentloaded', timeout:30000}); if(page.url().includes('/protocol/openid-connect/auth')){ await page.fill('#username', process.env.PW_AUDIT_USER); await page.fill('#password', process.env.PW_AUDIT_PASS); await Promise.all([page.waitForNavigation({waitUntil:'domcontentloaded', timeout:30000}).catch(()=>{}), page.click('#kc-login')]); } await page.waitForTimeout(6000); const body=await page.locator('body').innerText({timeout:5000}); const errorCount=(body.match(/Không tải được API dashboard/g)||[]).length; const rawRole=body.includes('file_service_delete'); await page.screenshot({path:'.tmp/audit-dashboard-after.png', fullPage:true}); console.log(JSON.stringify({url:page.url(), hasVietnameseTitle:body.includes('Bảng điều khiển quản trị hệ thống'), errorCount, rawRole, hasDetail:body.includes('Chi tiết dashboard'), body:body.slice(0,1400), events:events.slice(0,20)}, null, 2)); await browser.close(); })().catch(err=>{ console.error(err); process.exit(1); });\""], decision="allow")
prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "New-Item -ItemType Directory -Force -Path .tmp | Out-Null; $out = Resolve-Path .tmp; $stdout = Join-Path $out 'ng-serve-4302.out.log'; $stderr = Join-Path $out 'ng-serve-4302.err.log'; $process = Start-Process -FilePath 'npm.cmd' -ArgumentList @('run','start','--','--host','127.0.0.1','--port','4302') -WorkingDirectory (Get-Location) -WindowStyle Hidden -RedirectStandardOutput $stdout -RedirectStandardError $stderr -PassThru; Write-Output \"pid=$($process.Id); url=http://127.0.0.1:4302/; stdout=$stdout; stderr=$stderr\""], decision="allow")
prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "New-Item -ItemType Directory -Force -Path .tmp | Out-Null; $out = Resolve-Path .tmp; $stdout = Join-Path $out 'ng-serve-4302.out.log'; $stderr = Join-Path $out 'ng-serve-4302.err.log'; $process = Start-Process -FilePath 'cmd.exe' -ArgumentList @('/c','npm.cmd run start -- --host 127.0.0.1 --port 4302') -WorkingDirectory (Get-Location) -WindowStyle Hidden -RedirectStandardOutput $stdout -RedirectStandardError $stderr -PassThru; Write-Output \"pid=$($process.Id); url=http://127.0.0.1:4302/; stdout=$stdout; stderr=$stderr\""], decision="allow")
prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "$env:PW_AUDIT_USER='lamld'; $env:PW_AUDIT_PASS='Zzxx25102001'; node -e \"const { chromium } = require('playwright'); (async()=>{ const browser=await chromium.launch({headless:true}); const context=await browser.newContext({viewport:{width:1366,height:768}, ignoreHTTPSErrors:true}); const page=await context.newPage(); const events=[]; page.on('console', msg=>{ if(['error','warning'].includes(msg.type())) events.push(msg.type()+': '+msg.text()); }); page.on('pageerror', err=>events.push('pageerror: '+err.message)); await page.goto('http://localhost:4200/admin/ai-agent/runtime/playground', {waitUntil:'domcontentloaded', timeout:30000}); if(page.url().includes('/protocol/openid-connect/auth')){ await page.fill('#username', process.env.PW_AUDIT_USER); await page.fill('#password', process.env.PW_AUDIT_PASS); await Promise.all([page.waitForNavigation({waitUntil:'domcontentloaded', timeout:30000}).catch(()=>{}), page.click('#kc-login')]); } await page.waitForTimeout(6000); const body=await page.locator('body').innerText({timeout:5000}); const buttons=await page.locator('button, [role=button], a[href], input[type=button], input[type=submit]').evaluateAll(nodes=>nodes.slice(0,120).map((n,i)=>({i, tag:n.tagName, text:(n.innerText||n.getAttribute('aria-label')||n.getAttribute('title')||n.getAttribute('value')||'').trim(), disabled:n.disabled||n.getAttribute('aria-disabled')==='true', href:n.getAttribute('href'), cls:String(n.className||'')}))).catch(()=>[]); await page.screenshot({path:'.tmp/audit-ai-agent-playground.png', fullPage:true}); await page.setViewportSize({width:390,height:844}); await page.waitForTimeout(1000); await page.screenshot({path:'.tmp/audit-ai-agent-playground-mobile.png', fullPage:true}); console.log(JSON.stringify({url:page.url(), body:body.slice(0,2200), buttons, events:events.slice(0,30)}, null, 2)); await browser.close(); })().catch(err=>{ console.error(err); process.exit(1); });\""], decision="allow")
prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "$env:PW_AUDIT_USER='lamld'; $env:PW_AUDIT_PASS='Zzxx25102001'; node -e \"const { chromium } = require('playwright'); (async()=>{ const browser=await chromium.launch({headless:true}); const context=await browser.newContext({viewport:{width:1366,height:768}, ignoreHTTPSErrors:true}); const page=await context.newPage(); const results=[]; async function login(){ await page.goto('http://localhost:4200/admin/ai-agent/runtime/playground', {waitUntil:'domcontentloaded', timeout:30000}); if(page.url().includes('/protocol/openid-connect/auth')){ await page.fill('#username', process.env.PW_AUDIT_USER); await page.fill('#password', process.env.PW_AUDIT_PASS); await Promise.all([page.waitForNavigation({waitUntil:'domcontentloaded', timeout:30000}).catch(()=>{}), page.click('#kc-login')]); } await page.waitForTimeout(6000); } async function record(name){ const body=await page.locator('body').innerText({timeout:5000}).catch(e=>''); results.push({name, url:page.url(), body:body.slice(0,1800)}); } await login(); await record('initial'); await page.getByRole('button', {name:/Chạy request/i}).click({timeout:5000}).catch(e=>results.push({name:'run-click-error', error:e.message})); await page.waitForTimeout(1500); await record('after-empty-run'); await page.getByRole('button', {name:/Chi tiết/i}).click({timeout:5000}).catch(e=>results.push({name:'detail-click-error', error:e.message})); await page.waitForTimeout(800); await record('after-detail-tab'); await page.locator('.input-area__zoom-button').first().click({timeout:5000}).catch(e=>results.push({name:'zoom-click-error', error:e.message})); await page.waitForTimeout(1000); await record('after-zoom'); await page.keyboard.press('Escape').catch(()=>{}); await page.waitForTimeout(500); await page.locator('.p-select-dropdown').first().click({timeout:5000}).catch(e=>results.push({name:'agent-dropdown-click-error', error:e.message})); await page.waitForTimeout(1000); await record('after-agent-dropdown'); console.log(JSON.stringify(results, null, 2)); await browser.close(); })().catch(err=>{ console.error(err); process.exit(1); });\""], decision="allow")
prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "$env:PW_AUDIT_USER='lamld'; $env:PW_AUDIT_PASS='Zzxx25102001'; node -e \"const { chromium } = require('playwright'); (async()=>{ const browser=await chromium.launch({headless:true}); const context=await browser.newContext({viewport:{width:1366,height:768}, ignoreHTTPSErrors:true}); const page=await context.newPage(); const events=[]; page.on('console', msg=>{ if(['error','warning'].includes(msg.type())) events.push(msg.type()+': '+msg.text()); }); page.on('pageerror', err=>events.push('pageerror: '+err.message)); await page.goto('http://localhost:4200/admin/ai-agent/runtime/playground', {waitUntil:'domcontentloaded', timeout:30000}); if(page.url().includes('/protocol/openid-connect/auth')){ await page.fill('#username', process.env.PW_AUDIT_USER); await page.fill('#password', process.env.PW_AUDIT_PASS); await Promise.all([page.waitForNavigation({waitUntil:'domcontentloaded', timeout:30000}).catch(()=>{}), page.click('#kc-login')]); } await page.waitForTimeout(7000); const body=await page.locator('body').innerText({timeout:5000}); const buttons=await page.locator('button').evaluateAll(nodes=>nodes.map((n,i)=>({i,text:(n.innerText||n.getAttribute('aria-label')||n.getAttribute('title')||'').trim(),disabled:n.disabled||n.getAttribute('aria-disabled')==='true', cls:String(n.className||'')})).filter(x=>['Xóa kết quả','Chạy request'].some(t=>x.text.includes(t)))); await page.locator('.p-select-dropdown').first().click({timeout:5000}).catch(e=>events.push('select-click: '+e.message)); await page.waitForTimeout(1000); const afterDropdown=await page.locator('body').innerText({timeout:5000}); await page.screenshot({path:'.tmp/audit-ai-agent-playground-after.png', fullPage:true}); console.log(JSON.stringify({url:page.url(), hasDependencyAlert:body.includes('Không tải được danh sách agent/model'), hasClear:body.includes('Xóa kết quả'), buttons, dropdownVietnamese:afterDropdown.includes('Không có dữ liệu'), dropdownEnglish:afterDropdown.includes('No results found'), body:body.slice(0,1800), events:events.slice(0,30)}, null, 2)); await browser.close(); })().catch(err=>{ console.error(err); process.exit(1); });\""], decision="allow")
