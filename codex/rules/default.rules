prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "$env:PW_AUDIT_USER='lamld'; $env:PW_AUDIT_PASS='Zzxx25102001'; node -e \"const { chromium } = require('playwright'); (async()=>{ const browser=await chromium.launch({headless:true}); const context=await browser.newContext({viewport:{width:1366,height:768}, ignoreHTTPSErrors:true}); const page=await context.newPage(); const events=[]; page.on('console', msg=>{ if(['error','warning'].includes(msg.type())) events.push(msg.type()+': '+msg.text()); }); page.on('pageerror', err=>events.push('pageerror: '+err.message)); await page.goto('http://localhost:4200/admin/codex-agent/agents', {waitUntil:'domcontentloaded', timeout:30000}); if(page.url().includes('/protocol/openid-connect/auth')){ await page.fill('#username', process.env.PW_AUDIT_USER); await page.fill('#password', process.env.PW_AUDIT_PASS); await Promise.all([page.waitForNavigation({waitUntil:'domcontentloaded', timeout:30000}).catch(()=>{}), page.click('#kc-login')]); } await page.waitForTimeout(7000); const body=await page.locator('body').innerText({timeout:5000}); await page.screenshot({path:'.tmp/audit-codex-agent-list.png', fullPage:true}); await page.setViewportSize({width:390,height:844}); await page.waitForTimeout(1000); await page.screenshot({path:'.tmp/audit-codex-agent-list-mobile.png', fullPage:true}); console.log(JSON.stringify({url:page.url(), hasEmptyTable:body.includes('Không có dữ liệu phù hợp'), hasErrorText:body.includes('Không tải'), body:body.slice(0,1800), events:events.slice(0,30)}, null, 2)); await browser.close(); })().catch(err=>{ console.error(err); process.exit(1); });\""], decision="allow")
prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "$env:PW_AUDIT_USER='lamld'; $env:PW_AUDIT_PASS='Zzxx25102001'; node -e \"const { chromium } = require('playwright'); (async()=>{ const browser=await chromium.launch({headless:true}); const context=await browser.newContext({viewport:{width:1366,height:768}, ignoreHTTPSErrors:true}); const page=await context.newPage(); await page.goto('http://localhost:4200/admin/codex-agent/agents', {waitUntil:'domcontentloaded', timeout:30000}); if(page.url().includes('/protocol/openid-connect/auth')){ await page.fill('#username', process.env.PW_AUDIT_USER); await page.fill('#password', process.env.PW_AUDIT_PASS); await Promise.all([page.waitForNavigation({waitUntil:'domcontentloaded', timeout:30000}).catch(()=>{}), page.click('#kc-login')]); } await page.waitForTimeout(7000); const body=await page.locator('body').innerText({timeout:5000}); await page.screenshot({path:'.tmp/audit-codex-agent-list-after.png', fullPage:true}); await page.setViewportSize({width:390,height:844}); await page.waitForTimeout(1000); await page.screenshot({path:'.tmp/audit-codex-agent-list-mobile-after.png', fullPage:true}); console.log(JSON.stringify({url:page.url(), hasErrorState:body.includes('Không tải được danh sách Codex agent'), hasEmptyTable:body.includes('Không có dữ liệu phù hợp'), hasVietnameseListTitle:body.includes('Danh sách Codex agent'), body:body.slice(0,1400)}, null, 2)); await browser.close(); })().catch(err=>{ console.error(err); process.exit(1); });\""], decision="allow")
prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "$env:PW_AUDIT_USER='lamld'; $env:PW_AUDIT_PASS='Zzxx25102001'; node -e \"const { chromium } = require('playwright'); (async()=>{ const browser=await chromium.launch({headless:true}); const context=await browser.newContext({viewport:{width:1366,height:768}, ignoreHTTPSErrors:true}); const page=await context.newPage(); const results=[]; await page.goto('http://localhost:4200/admin/codex-agent/agents', {waitUntil:'domcontentloaded', timeout:30000}); if(page.url().includes('/protocol/openid-connect/auth')){ await page.fill('#username', process.env.PW_AUDIT_USER); await page.fill('#password', process.env.PW_AUDIT_PASS); await Promise.all([page.waitForNavigation({waitUntil:'domcontentloaded', timeout:30000}).catch(()=>{}), page.click('#kc-login')]); } await page.waitForTimeout(7000); await page.getByRole('button', {name:/Thử lại/i}).click({timeout:5000}); await page.waitForTimeout(2000); let body=await page.locator('body').innerText({timeout:5000}); results.push({step:'retry', hasError:body.includes('Không tải được danh sách Codex agent'), url:page.url()}); await page.getByRole('button', {name:/Tạo Codex agent/i}).click({timeout:5000}); await page.waitForTimeout(2500); body=await page.locator('body').innerText({timeout:5000}); results.push({step:'create', url:page.url(), hasCreateTitle:body.includes('Tạo Codex agent'), body:body.slice(0,1000)}); console.log(JSON.stringify(results, null, 2)); await browser.close(); })().catch(err=>{ console.error(err); process.exit(1); });\""], decision="allow")
